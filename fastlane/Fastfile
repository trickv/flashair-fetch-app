# fastlane/Fastfile — FlashAir Sync (iOS)
#
#   bundle exec fastlane ios beta    # archive + sign + upload to TestFlight (what CI runs)
#   bundle exec fastlane ios build   # archive + sign only, no upload (local signing smoke test)
#
# There is deliberately NO `platform :android` block. The Android app under
# android/ is not published anywhere. A lane nobody runs rots silently and
# eventually tempts someone into "fixing" it into shipping something.
#
# This otherwise mirrors ../baby-monitor and ../look-up, but three differences
# are load-bearing and copying those Fastfiles verbatim will not work here:
#
#   1. FlashAirSync.xcodeproj is GENERATED by XcodeGen and is gitignored, so
#      this lane generates it (see `preflight_release`) instead of assuming
#      it exists. That also means `bundle exec fastlane ios beta` reproduces a
#      release identically at a desk and in CI, and a stale hand-edited local
#      project can never ship.
#   2. No CocoaPods, no .xcworkspace — `build_app` takes `project:`. The
#      reference repos pass `workspace:` because they are Pods projects.
#   3. Version/build numbers are injected as xcodebuild command-line build
#      settings (`xcargs`), NOT with increment_version_number /
#      increment_build_number. See VERSION INJECTION below.
#
# VERSION INJECTION — read this before changing anything version-related.
# The reference Fastfiles call increment_version_number, which drives agvtool
# and writes the MARKETING_VERSION / CURRENT_PROJECT_VERSION *build settings*.
# On this project that reaches the built bundle only if Info.plist references
# those settings; agvtool also wants VERSIONING_SYSTEM = apple-generic, which
# project.yml does not set, and it rewrites tracked files — dirtying the tree,
# which makes project.yml's postBuildScript stamp GitCommitHash as
# "<sha>-dirty" into the shipped build.
# So instead: project.yml's info.properties declares
#     CFBundleShortVersionString: "$(MARKETING_VERSION)"
#     CFBundleVersion:            "$(CURRENT_PROJECT_VERSION)"
# and this lane overrides those two settings on the xcodebuild command line,
# which has the highest precedence and leaves the working tree untouched.
# `preflight_release` hard-fails when that wiring is missing: the symptom is
# otherwise invisible until it hurts: every build ships as 1.0 (1), upload #1
# succeeds, and upload #2 is rejected for a duplicate build number.

require "shellwords"

default_platform(:ios)

# Must agree with fastlane/Appfile, ios/FlashAirSync/project.yml
# (PRODUCT_BUNDLE_IDENTIFIER), and the App Store distribution profile created
# in the Developer Portal.
APP_IDENTIFIER = "us.v9n.flashair-sync".freeze
# Matched literally against the profile's *Name* field — not its filename and
# not its UUID. A mismatch yields the unhelpful
# "No profile for team ... matching 'flashair-sync' found".
PROFILE_NAME = "flashair-sync".freeze
SCHEME = "FlashAirSync".freeze

# --- path helpers ------------------------------------------------------------
#
# fastlane's working directory is not uniform: the lane body and `sh` run from
# <repo>/fastlane, while every action runs from <repo>. Absolute paths derived
# from the repo root remove that entire class of bug.

def repo_root
  @repo_root ||= begin
    root = `git rev-parse --show-toplevel 2>/dev/null`.strip
    if root.empty?
      # Not a git checkout (tarball export?). Probe both CWDs fastlane uses.
      root = [Dir.pwd, File.expand_path("..", Dir.pwd)].find do |dir|
        File.exist?(File.join(dir, "ios", "FlashAirSync", "project.yml"))
      end
      UI.user_error!("Can't locate the repo root — run fastlane from inside the checkout.") if root.nil?
    end
    root
  end
end

def ios_dir
  File.join(repo_root, "ios", "FlashAirSync")
end

def xcodeproj_path
  File.join(ios_dir, "#{SCHEME}.xcodeproj")
end

# The tracked, XcodeGen-generated source plist (not the one inside the bundle).
def source_info_plist_path
  File.join(ios_dir, SCHEME, "Info.plist")
end

# --- input resolution --------------------------------------------------------
#
# Fail with an actionable sentence before the 5-minute archive, not with a
# fastlane stack trace after it.

def require_env!(*names)
  missing = names.reject { |name| ENV[name].to_s.strip != "" }
  return if missing.empty?

  UI.user_error!(<<~MSG)
    Missing required environment variable(s): #{missing.join(', ')}

    In CI these come from repo secrets via .github/workflows/release.yml.
    Locally, export them by hand:
      export ASC_API_KEY_ID=...        # 10-char App Store Connect key ID
      export ASC_API_ISSUER_ID=...     # issuer UUID, shared by all team keys
      export ASC_API_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_<ID>.p8
      export APPLE_TEAM_ID=99CP4GY776  # optional; falls back to fastlane/Appfile
    Or run `bundle exec fastlane ios build`, which archives without uploading
    and needs none of the App Store Connect credentials.
  MSG
end

def resolve_team_id!
  team = ENV["APPLE_TEAM_ID"].to_s.strip
  team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id).to_s.strip if team.empty?
  UI.user_error!("No team ID: set APPLE_TEAM_ID or team_id in fastlane/Appfile.") if team.empty?
  team
end

# Version comes from the git tag (v0.1.0 -> 0.1.0). APP_VERSION is honoured
# first so the release workflow can resolve it once (it also has to cover
# workflow_dispatch, where there is no tag to read).
def resolve_version!(options, fallback: nil)
  raw = [options[:version], ENV["APP_VERSION"], ENV["GITHUB_REF_NAME"]]
        .map { |v| v.to_s.strip }.find { |v| !v.empty? }
  raw = fallback if raw.nil? && fallback
  if raw.to_s.empty?
    UI.user_error!("No version to build. Pass `version:0.1.0`, or set APP_VERSION, or run from a tag (GITHUB_REF_NAME).")
  end

  version = raw.sub(/\A[vV]/, "")
  unless version =~ /\A\d+(\.\d+){0,2}\z/
    UI.user_error!("Version #{version.inspect} isn't an Apple-acceptable CFBundleShortVersionString (1-3 dot-separated integers). Tags are expected as vMAJOR.MINOR.PATCH.")
  end
  version
end

# Build number is this workflow's GitHub run number: monotonic for
# .github/workflows/release.yml *specifically*, not repo-wide. Renaming or
# deleting-and-recreating that workflow file resets the counter to 1, and App
# Store Connect rejects a reused CFBundleVersion. If it is ever renamed, pass
# APP_BUILD past the highest build already uploaded. Never hand-lower it.
def resolve_build_number!(options, fallback: nil)
  raw = [options[:build], ENV["APP_BUILD"], ENV["GITHUB_RUN_NUMBER"]]
        .map { |v| v.to_s.strip }.find { |v| !v.empty? }
  raw = fallback if raw.nil? && fallback
  if raw.to_s.empty?
    UI.user_error!("No build number. Pass `build:42`, or set APP_BUILD / GITHUB_RUN_NUMBER.")
  end
  unless raw =~ /\A\d+(\.\d+){0,2}\z/
    UI.user_error!("Build number #{raw.inspect} must be 1-3 dot-separated integers (CFBundleVersion).")
  end
  raw
end

platform :ios do
  desc "Archive, sign, and upload to TestFlight. Driven by .github/workflows/release.yml on a published GitHub Release."
  lane :beta do |options|
    require_env!("ASC_API_KEY_ID", "ASC_API_ISSUER_ID", "ASC_API_KEY_PATH")
    key_path = File.expand_path(ENV["ASC_API_KEY_PATH"])
    UI.user_error!("ASC_API_KEY_PATH points at #{key_path}, which doesn't exist. The .p8 is downloadable exactly once — check your password manager.") unless File.exist?(key_path)

    team_id = resolve_team_id!
    version = resolve_version!(options)
    build_number = resolve_build_number!(options)
    UI.message("Building #{version} (#{build_number}) for team #{team_id}")

    preflight_release(strict_version_check: true)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_filepath: key_path,
    )

    ipa = archive_ipa(version: version, build_number: build_number, team_id: team_id)

    notes = ENV["RELEASE_NOTES"].to_s.strip
    notes = "Bug fixes and improvements." if notes.empty?

    # skip_waiting_for_build_processing still applies the changelog: pilot
    # waits just long enough for the build to appear, sets "What to Test",
    # then skips the rest of processing. It does NOT wait for Apple's
    # validation verdict — a rejection (missing icon, ITMS-91053 privacy
    # manifest, duplicate build number) arrives by email 5-30 minutes after
    # this lane goes green, and the build simply never shows up in TestFlight.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      changelog: notes,
    )

    # Sentry dSYM upload is deliberately NOT wired here. sentry-cli needs the
    # org and project *slugs*, and the committed DSN only yields numeric IDs,
    # so any value here would be a guess that fails at release time. The
    # release workflow attaches FlashAirSync.app.dSYM.zip to the GitHub
    # Release instead, so symbolication stays recoverable by hand.
    # To add it later (no fastlane plugin needed, never fails the release):
    #   sh("[ -n \"${SENTRY_AUTH_TOKEN:-}\" ] && sentry-cli debug-files upload " \
    #      "--org <org-slug> --project <project-slug> " \
    #      "#{lane_context[SharedValues::DSYM_OUTPUT_PATH].to_s.shellescape} || true")
  end

  desc "Archive + sign locally without uploading — smoke-test the release signing path before cutting a tag."
  lane :build do |options|
    team_id = resolve_team_id!
    # Local smoke tests have no tag; the artifact is never uploaded, so a
    # placeholder version is fine and beats making the user invent one.
    version = resolve_version!(options, fallback: "0.0.0")
    build_number = resolve_build_number!(options, fallback: "0")

    # Warn-only: a broken version wiring doesn't matter for a build that never
    # reaches App Store Connect, and hard-failing here would block the very
    # smoke test you'd use to debug signing.
    preflight_release(strict_version_check: false)

    ipa = archive_ipa(version: version, build_number: build_number, team_id: team_id)
    UI.success("Signed #{version} (#{build_number}) -> #{ipa}")
    UI.important("Not uploaded. This needs the Apple Distribution cert and the '#{PROFILE_NAME}' App Store profile installed locally; if it signed, CI will too.")
  end

  # The _release / _ipa suffixes keep these two internal lanes from reading like
  # fastlane actions — bare `preflight` / `archive` would sit confusingly next to
  # the actions they wrap. This is readability, NOT a hard requirement: verified
  # against fastlane/lib/fastlane/lane.rb, only `deny_list` (run, init, lanes,
  # docs, action(s), help, env, *_plugin(s), update_fastlane) raises
  # UI.user_error!. An action-name collision goes through
  # ensure_name_not_conflicts, which merely prints UI.error and runs the lane
  # anyway; gray_list (Fastlane::TOOLS) likewise only warns — "We still allow
  # it, because we're nice", per the upstream comment. Nothing refuses to parse.
  # (`lane :build` above is fine for the same reason, and is not even a
  # collision: the action is `build_app`, not `build`.)
  desc "Regenerate the Xcode project and verify release wiring (internal)."
  private_lane :preflight_release do |options|
    strict = options.fetch(:strict_version_check, true)

    UI.user_error!("xcodegen is not on PATH — `brew install xcodegen`.") if `which xcodegen`.strip.empty?

    # Generate first: xcodegen rewrites both the .xcodeproj and the tracked
    # FlashAirSync/Info.plist, so anything written before this point is lost —
    # in particular update_code_signing_settings, which must come after.
    # `sh` runs with CWD = <repo>/fastlane, hence the absolute cd.
    sh("cd #{ios_dir.shellescape} && xcodegen generate")

    # If the committed Info.plist was out of date, xcodegen just changed a
    # tracked file and `git describe --dirty` in project.yml's postBuildScript
    # will stamp GitCommitHash as "<sha>-dirty" into the shipped build.
    #
    # --untracked-files=no is load-bearing, not tidiness: `git describe --dirty`
    # decides via `git diff-index`, which sees TRACKED modifications only. A bare
    # `status --porcelain` also lists untracked files, and CI always has plenty
    # (ruby/setup-ruby's bundler-cache writes vendor/bundle/** into the
    # workspace), so this would warn on every single run while the stamp was in
    # fact clean — and a guard that cries wolf from run #1 gets trained-ignored,
    # which costs us the one case it exists to catch: a genuinely stale
    # committed Info.plist.
    dirty = `git -C #{repo_root.shellescape} status --porcelain --untracked-files=no`.strip
    unless dirty.empty?
      UI.important("Working tree is dirty — GitCommitHash will be stamped '-dirty'. Run `cd ios/FlashAirSync && xcodegen generate` and commit the result:\n#{dirty}")
    end

    marketing = get_info_plist_value(path: source_info_plist_path, key: "CFBundleShortVersionString")
    bundle_version = get_info_plist_value(path: source_info_plist_path, key: "CFBundleVersion")
    wired = marketing == "$(MARKETING_VERSION)" && bundle_version == "$(CURRENT_PROJECT_VERSION)"

    unless wired
      message = <<~MSG
        Info.plist does not reference the version build settings, so this build would
        ship as #{marketing} (#{bundle_version}) no matter what version you asked for.

        Fix in ios/FlashAirSync/project.yml under targets.FlashAirSync.info.properties:
          CFBundleShortVersionString: "$(MARKETING_VERSION)"
          CFBundleVersion: "$(CURRENT_PROJECT_VERSION)"
        then `cd ios/FlashAirSync && xcodegen generate` and commit the regenerated plist.
      MSG
      strict ? UI.user_error!(message) : UI.important(message)
    end

    # Soft checks — neither breaks the archive, both cost a TestFlight round trip.
    if get_info_plist_value(path: source_info_plist_path, key: "ITSAppUsesNonExemptEncryption").nil?
      UI.important("ITSAppUsesNonExemptEncryption is unset — every TestFlight build will park in 'Missing Compliance' until answered by hand. Add `ITSAppUsesNonExemptEncryption: false` to project.yml's info.properties.")
    end
    unless File.directory?(File.join(ios_dir, SCHEME, "Assets.xcassets", "AppIcon.appiconset"))
      UI.important("No AppIcon.appiconset — the archive will succeed and App Store Connect will then reject the upload (ITMS-90022).")
    end
  end

  desc "Sign and archive at a given version (internal)."
  private_lane :archive_ipa do |options|
    # Writes CODE_SIGN_STYLE/DEVELOPMENT_TEAM/CODE_SIGN_IDENTITY/
    # PROVISIONING_PROFILE_SPECIFIER/PRODUCT_BUNDLE_IDENTIFIER into the
    # generated (gitignored) pbxproj. `bundle_identifier:` SETS the value
    # rather than filtering by it, so the release bundle ID is forced here
    # even if project.yml still carries an older one.
    #
    # App target only: the generated scheme's ArchiveAction builds just
    # FlashAirSync.app, so FlashAirSyncTests is never built and signing it
    # would be pure ceremony.
    update_code_signing_settings(
      path: xcodeproj_path,
      use_automatic_signing: false,
      team_id: options[:team_id],
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: APP_IDENTIFIER,
      targets: [SCHEME],
    )

    build_app(
      project: xcodeproj_path, # not `workspace:` — no CocoaPods here, SPM only
      scheme: SCHEME,
      configuration: "Release",
      # Xcode 26.6+ -exportArchive prints: Command line name "app-store" is
      # deprecated. Use "app-store-connect" instead. IGNORE IT FOR NOW — the new
      # spelling is an xcodebuild-side rename that fastlane has not adopted.
      # gym validates this value against a hardcoded allow-list before the
      # archive even starts (gym/lib/gym/options.rb, the :export_method
      # verify_block): %w(app-store validation ad-hoc package enterprise
      # development developer-id mac-application). Feeding it
      # "app-store-connect" aborts the lane outright with "Unsupported
      # export_method". Checked against fastlane 2.238.0, which is both what a
      # fresh `bundle install` resolves (the Gemfile pins no version and 2.238.0
      # is the newest published release) and what CI therefore runs; the string
      # "app-store-connect" appears nowhere in that gem.
      # Migration trigger: when gym's allow-list gains "app-store-connect",
      # switch. Until then this warning is cosmetic, and "fixing" it fails the
      # whole release.
      export_method: "app-store",
      # Hash form is shell-escaped by fastlane, so no quoting hazards. Values
      # must be Strings (they get .shellescape'd).
      xcargs: {
        "MARKETING_VERSION" => options[:version],
        "CURRENT_PROJECT_VERSION" => options[:build_number],
      },
      export_options: {
        signingStyle: "manual",
        teamID: options[:team_id],
        # Diverges from the reference Fastfiles: left at its default (true),
        # Xcode may rewrite version/build during -exportArchive and silently
        # decouple CFBundleVersion from the run number we just archived.
        manageAppVersionAndBuildNumber: false,
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME,
        },
      },
      # Absolute, so the release workflow's `files: *.ipa` (evaluated at the
      # repo root) always matches. gym drops FlashAirSync.app.dSYM.zip here too.
      output_directory: repo_root,
      output_name: "#{SCHEME}.ipa",
    )
  end
end
