# macOS
.DS_Store

# iOS
ios/FlashAirSync/Build/
ios/FlashAirSync/DerivedData/
# .xcodeproj is generated from project.yml via XcodeGen; never commit it.
ios/FlashAirSync/*.xcodeproj/
ios/FlashAirSync/*.xcworkspace/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/.externalNativeBuild
android/.cxx

# Gradle (exclude caches but keep wrapper)
android/.gradle/
android/gradle/*
!android/gradle/wrapper/

# Python
tools/mock-flashair/__pycache__/
tools/mock-flashair/*.pyc
tools/mock-flashair/.venv/
tools/mock-flashair/venv/

# Test data (keep structure, ignore large test files if added)
tools/mock-flashair/test-data/**/*.JPG
tools/mock-flashair/test-data/**/*.MP4
!tools/mock-flashair/test-data/DCIM/100CANON/.gitkeep
!tools/mock-flashair/test-data/DCIM/100CANON/IMG_*.JPG

# Logs
*.log

# Local screen recordings of the app (not deliverables)
ScreenRecording_*.mp4
ScreenRecording_*.mov

# fastlane
# Run artifacts, not deliverables. The FlashAirSync.ipa and
# FlashAirSync.app.dSYM.zip that `fastlane ios beta` drops at the repo root are
# already covered by the *.ipa / *.dSYM.zip rules in the iOS section above.
# fastlane/README.md is REGENERATED by DocsGenerator after every lane run
# (lane_manager.rb calls it unless FASTLANE_SKIP_DOCS is set). Committed, it
# would dirty the tree on each local `fastlane ios build` and make the
# preflight dirty-tree guard cry wolf — the one thing that comment swears it
# must never do. Neither ../baby-monitor nor ../look-up commits it either.
fastlane/README.md
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
# ruby/setup-ruby's `bundler-cache: true` runs `bundle config --local path
# $PWD/vendor/bundle`, so every CI release run materialises thousands of gem
# files inside $GITHUB_WORKSPACE. Un-ignored, they turn the Fastfile's
# dirty-tree guard into permanent false-positive noise and make a careless
# local `git add -A` commit the whole gem tree. ../baby-monitor and ../look-up
# each carry /vendor/bundle/ only; .bundle/ is this repo going one better.
/vendor/bundle/
.bundle/
# Gemfile.lock is deliberately uncommitted, matching ../baby-monitor and
# ../look-up: ruby/setup-ruby's bundler-cache resolves it in CI. See the
# comment in Gemfile for the tradeoff.
Gemfile.lock

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
